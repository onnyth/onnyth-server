# ==========================================
# Onnyth Server Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# The .env file is automatically loaded by spring-dotenv library.
# No need to export variables manually - just run the app!

# ==========================================
# Database Configuration (PostgreSQL/Supabase)
# ==========================================
# Recommended for local dev: run `supabase start` (see HELP.md), which starts a full
# local Supabase stack including Postgres on 127.0.0.1:54322 with default creds below.
DATABASE_URL=jdbc:postgresql://127.0.0.1:54322/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# To point at a real remote/cloud Supabase project instead, comment out the block above
# and use:
# DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your-database-password

# ==========================================
# Supabase Configuration
# ==========================================
# Run `supabase status -o env` after `supabase start` and copy ANON_KEY/SERVICE_ROLE_KEY
# from its output into the values below.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# For a remote/cloud project instead:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# Optional Configuration
# ==========================================
# Set to true to show SQL queries in logs
JPA_SHOW_SQL=false

